# Base de datos
# Desarrollo local (SQLite, sin instalación adicional):
DATABASE_URL=sqlite+aiosqlite:///./dev.db
# Al migrar a Postgres, comentar la línea de arriba y usar:
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/pm_tool

ENVIRONMENT=development

# Seguridad — generar con: openssl rand -hex 32
SECRET_KEY=changeme
ACCESS_TOKEN_EXPIRE_MINUTES=30
